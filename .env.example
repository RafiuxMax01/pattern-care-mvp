# =====================================================================
# PATTERN CARE ERP - Variables de entorno para Docker
# Copia este archivo a .env y ajusta los valores según tu entorno
# =====================================================================

# Base de datos MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=pattern_care
MYSQL_USER=pattern_user
MYSQL_PASSWORD=pattern_pass

# Puerto del servidor web (localhost:8000)
WEB_PORT=8000

# Puerto de phpMyAdmin (localhost:8080)
PMA_PORT=8080
